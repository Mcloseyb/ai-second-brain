/* ============================================================
   AI Second Brain — 全局主题样式表

   设计方向: Notion 风格的暗色主题
   调整方式: 修改此文件即可全局生效，不需要改 Python 代码

   颜色规范: 见 colors.py（QSS 不支持 Python 变量，手动同步）
   ============================================================ */

/* ============================================================
   1. 全局基础
   ============================================================ */

QMainWindow {
    background-color: #111110;
}

QWidget {
    background-color: transparent;
    color: #E1E1E0;
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}

/* ============================================================
   2. 滚动条
   ============================================================ */

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3A3A38;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #5A5A56;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #3A3A38;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #5A5A56;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

/* ============================================================
   3. Tab Widget (内容区顶部标签)
   ============================================================ */

QTabWidget::pane {
    background: #1D1D1C;
    border: none;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #999995;
    padding: 8px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 13px;
}

QTabBar::tab:hover {
    color: #E1E1E0;
    background: #252523;
}

QTabBar::tab:selected {
    color: #E1E1E0;
    border-bottom: 2px solid #6B9FFF;
}

/* ============================================================
   4. 输入框
   ============================================================ */

QTextEdit, QPlainTextEdit, QLineEdit {
    background-color: #2A2A28;
    color: #E1E1E0;
    border: 1px solid #2E2E2C;
    border-radius: 8px;
    padding: 8px 12px;
    selection-background-color: #6B9FFF;
    selection-color: #111110;
}

QTextEdit:focus, QPlainTextEdit:focus, QLineEdit:focus {
    border-color: #5A5A56;
    background-color: #31312F;
}

/* ============================================================
   5. 按钮
   ============================================================ */

QPushButton {
    background-color: #252523;
    color: #E1E1E0;
    border: 1px solid #2E2E2C;
    border-radius: 6px;
    padding: 6px 16px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #2A2A28;
    border-color: #3A3A38;
}

QPushButton:pressed {
    background-color: #1D1D1C;
}

/* 主要按钮 */
QPushButton[cssClass="primary"] {
    background-color: #6B9FFF;
    color: #111110;
    border: none;
    font-weight: 600;
}

QPushButton[cssClass="primary"]:hover {
    background-color: #85B0FF;
}

/* 危险按钮 */
QPushButton[cssClass="danger"] {
    background-color: transparent;
    color: #E06C75;
    border: 1px solid #E06C75;
}

QPushButton[cssClass="danger"]:hover {
    background-color: #E06C75;
    color: #111110;
}

/* ============================================================
   6. 列表/树
   ============================================================ */

QTreeWidget, QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QTreeWidget::item, QListWidget::item {
    color: #999995;
    padding: 4px 8px;
    border-radius: 4px;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    color: #E1E1E0;
    background: #252523;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    color: #E1E1E0;
    background: #2E2E2C;
}

/* ============================================================
   7. 分割线
   ============================================================ */

QFrame[cssClass="divider"] {
    background: #2E2E2C;
    max-height: 1px;
    border: none;
}

/* ============================================================
   8. 状态栏
   ============================================================ */

QStatusBar {
    background: #151514;
    color: #6B6B66;
    border-top: 1px solid #2E2E2C;
    padding: 2px 8px;
    font-size: 11px;
}

/* ============================================================
   9. 菜单
   ============================================================ */

QMenu {
    background: #252523;
    color: #E1E1E0;
    border: 1px solid #2E2E2C;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #2E2E2C;
}

QMenu::separator {
    height: 1px;
    background: #2E2E2C;
    margin: 4px 8px;
}

/* ============================================================
   10. 工具提示
   ============================================================ */

QToolTip {
    background: #252523;
    color: #E1E1E0;
    border: 1px solid #3A3A38;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}
